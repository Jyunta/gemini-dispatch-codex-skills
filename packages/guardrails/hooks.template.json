{
  "deterministic-command-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.local/bin:$PATH\" exec node \"$HOME/skills/packages/guardrails/agy-pretool-guard.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
